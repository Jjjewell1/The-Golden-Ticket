# ---- The Golden Ticket ----
# Copy to .env (local dev) or set these in Coolify (production).

# Port the server listens on
PORT=8080

# Public URL of this site (used for OG meta tags)
PUBLIC_URL=https://goldenticket.jewellcore.com

# ---- Jellyfin ----
JELLYFIN_URL=http://192.168.1.154:8096
JELLYFIN_API_KEY=

# ---- RomM ----
ROMM_URL=http://192.168.1.154:8090
ROMM_ADMIN_USER=Jjjewell1
ROMM_ADMIN_PASSWORD=

# ---- Seerr (media requests) ----
SEERR_URL=http://192.168.1.154:5055
SEERR_API_KEY=

# ---- Access control ----
# Secret phrase friends must enter to get an account
TICKET_CODE=changeme
# PIN to unlock the owner-only section of the site
OWNER_PIN=changeme

# ---- Announcements ----
# JSON array, shown on the home page. Leave empty [] for none.
ANNOUNCEMENTS=[]

# ---- App cards ----
# JSON config for the launchpad cards. Overrides the built-in defaults.
# APPS=
