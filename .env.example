# ---- The Golden Ticket ----
# Local dev: copy to server/.env.
# Production (Coolify): paste the same values into the app's Environment Variables tab.

# Port the server listens on
PORT=8080

# Public URL of this site (used for OG meta tags and all approve/reset links)
PUBLIC_URL=https://goldenticket.jewellcore.com

# ---- Jellyfin ----
JELLYFIN_URL=http://192.168.1.154:8096
JELLYFIN_API_KEY=
JELLYFIN_USER=Eddie

# ---- RomM ----
ROMM_URL=http://192.168.1.154:8090
ROMM_ADMIN_USER=Jjjewell1
ROMM_ADMIN_PASSWORD=

# ---- Seerr (media requests) ----
SEERR_URL=http://192.168.1.154:5055
SEERR_API_KEY=

# ---- Linkwarden (bookmarks) ----
# Bearer token from Linkwarden: Settings > Access Tokens
LINKWARDEN_URL=https://link.jewellcore.com
LINKWARDEN_API_KEY=

# ---- Access control ----
# Secret phrase friends must enter to sign up
TICKET_CODE=changeme
# PIN shown on the sign-in page for the owner-only login
OWNER_PIN=changeme
# Owner account bootstrap (created automatically on first boot)
OWNER_ACCOUNT=JJ_Jewell
OWNER_ACCOUNT_PASSWORD=changeme

# ---- Sessions ----
# Any long random string; REQUIRED or sessions won't work. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ---- Pushover (owner approval notifications) ----
# App token + user key from pushover.net
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ---- ntfy (member notifications) ----
# Push notifications to members when new media is added or announcements are posted.
# NTFY_URL is the ntfy server (public relay https://ntfy.sh or a self-hosted one).
# NTFY_TOPIC is a long random string — it's both the "secret" and the subscribe link
# members use. Generate with: node -e "console.log(crypto.randomBytes(16).toString('hex'))"
# NTFY_AUTH is only needed if your ntfy server requires a Basic auth token (self-hosted).
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_AUTH=

# ---- Gmail SMTP (approval/denial + reset emails) ----
# Gmail app password: https://myaccount.google.com/apppasswords (2-Step Verification required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Announcements ----
# JSON array, shown on the home page. Leave [] for none.
ANNOUNCEMENTS=[]

# ---- App cards ----
# JSON config for the launchpad cards. Overrides the built-in defaults.
# APPS=
